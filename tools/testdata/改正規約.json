{
  "bylaws_title": "グランピア西白井（１ブロック）団地管理組合規約",
  "chapters": [
    {
      "chapter_number": "第１章",
      "chapter_title": "総則",
      "sections": [
        {
          "section_number": null,
          "section_title": null,
          "articles": [
            {
              "article_id": "art_0001",
              "article_number": "第１条",
              "title": "目的",
              "paragraphs": [
                {
                  "paragraph_no": 1,
                  "text": "この規約は、グランピア西白井（１ブロック）団地の管理又は使用に関する事項等について定めることにより、団地建物所有者の共同の利益を増進し、良好な住環境を確保することを目的とする。",
                  "items": []
                }
              ]
            },
            {
              "article_id": "art_0002",
              "article_number": "第２条",
              "title": "定義",
              "paragraphs": [
                {
                  "paragraph_no": 1,
                  "text": "この規約において、次の各号に掲げる用語の意義は、それぞれ当該各号に定めるところによる。",
                  "items": [
                    {
                      "item_no": "一",
                      "term": "区分所有権",
                      "definition": "建物の区分所有等に関する法律（昭和37年法律第69号。以下「区分所有法」という。）第２条第１項の区分所有権をいう。"
                    },
                    {
                      "item_no": "二",
                      "term": "区分所有者",
                      "definition": "区分所有法第２条第２項の区分所有者をいう。"
                    },
                    {
                      "item_no": "三",
                      "term": "団地建物所有者",
                      "definition": "区分所有法第65条の団地建物所有者をいう。"
                    },
                    {
                      "item_no": "四",
                      "term": "占有者",
                      "definition": "区分所有法第６条第３項の占有者をいう。"
                    },
                    {
                      "item_no": "五",
                      "term": "専有部分",
                      "definition": "区分所有法第２条第３項の専有部分をいう。"
                    },
                    {
                      "item_no": "六",
                      "term": "共用部分",
                      "definition": "区分所有法第２条第４項の共用部分（以下「棟の共用部分」という。）及び区分所有法第67条第1項の団地共用部分（以下「団地共用部分」という。）をいう。"
                    },
                    {
                      "item_no": "七",
                      "term": "土地",
                      "definition": "区分所有法第65条の土地（別表第１に記載された土地）をいう。"
                    },
                    {
                      "item_no": "八",
                      "term": "共用部分等",
                      "definition": "共用部分及び附属施設をいう。"
                    },
                    {
                      "item_no": "九",
                      "term": "専用使用権",
                      "definition": "土地及び共用部分等の一部について、特定の団地建物所有者が排他的に使用できる権利をいう。"
                    },
                    {
                      "item_no": "十",
                      "term": "専用使用部分",
                      "definition": "専用使用権の対象となっている土地及び共用部分等の部分をいう。（第14条第１項記載の対象部分をいう。）"
                    },
                    {
                      "item_no": "十一",
                      "term": "電磁的記録",
                      "definition": "電子計算機に備えられたファイル又は電磁的記録媒体（電子的方式、磁気的方式その他人の知覚によっては認識することができない方式で作られる記録であって電子計算機による情報処理の用に供されるものに係る記録媒体をいう。次号において同じ。）をもって調製するファイルに情報を記録したものをいう。"
                    },
                    {
                      "item_no": "十二",
                      "term": "電磁的方法",
                      "definition": "電子情報処理組織を使用する方法その他の情報通信の技術を利用する方法であって次に定めるものをいう。",
                      "sub_items": [
                        {
                          "sub_item_no": "イ",
                          "text": "電子情報処理組織を使用する方法のうち次に掲げるもの",
                          "details": [
                            {
                              "detail_no": "（１）",
                              "text": "送信者の使用に係る電子計算機と受信者の使用に係る電子計算機とを接続する電気通信回線を通じて送信し、受信者の使用に係る電子計算機に備えられたファイルに記録する方法"
                            },
                            {
                              "detail_no": "（２）",
                              "text": "送信者の使用に係る電子計算機に備えられたファイルに記録された情報の内容を電気通信回線を通じて情報の提供を受ける者の閲覧に供し、当該情報の提供を受ける者の使用に係る電子計算機に備えられたファイルに当該情報を記録する方法"
                            }
                          ]
                        },
                        {
                          "sub_item_no": "ロ",
                          "text": "電磁的記録媒体をもって調製するファイルに情報を記録したものを交付する方法"
                        }
                      ]
                    },
                    {
                      "item_no": "十三",
                      "term": "WEB会議システム等",
                      "definition": "電気通信回線を介して、即時性及び双方向性を備えた映像及び音声の通信を行うことができる会議システム等をいう。"
                    },
                    {
                      "item_no": "十四",
                      "term": "国内管理人",
                      "definition": "区分所有法第６条の２の国内管理人をいう。"
                    },
                    {
                      "item_no": "十五",
                      "term": "所有者不明専有部分管理人",
                      "definition": "区分所有法第46条の２第４項の所有者不明専有部分管理人をいう。"
                    },
                    {
                      "item_no": "十六",
                      "term": "管理不全専有部分管理人",
                      "definition": "区分所有法第46条の８第３項の管理不全専有部分管理人をいう。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
